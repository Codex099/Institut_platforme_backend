# Configuration générale de l'application
PROJECT_NAME="Plateforme Gestion Écoles"
ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Base de données PostgreSQL (Requis : PostgreSQL avec support des verrous FOR UPDATE)
# Format : postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/ecole_chlef_db"

# Sécurité & JWT
JWT_SECRET_KEY="change_me_super_secret_key_at_least_32_chars_long_for_security"
JWT_REFRESH_SECRET_KEY="change_me_refresh_super_secret_key_at_least_32_chars_long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Paramètres Métier par défaut (surchargés par la table settings)
DEFAULT_RESERVATION_HOURS=48
DEFAULT_DEPOSIT_MIN=2000.00
DEFAULT_GROUP_CAPACITY=15
ATTENDANCE_EDIT_WINDOW_HOURS=24
ROOM_CAPACITY_POLICY="warn" # none | warn | block

# Stockage de fichiers (local ou s3)
STORAGE_BACKEND="local" # local | s3
STORAGE_LOCAL_DIR="./uploads"

# Configuration Stockage S3 (pour production)
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="ecole-documents"
S3_REGION="eu-west-1"

# Sécurité & Réseau
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","https://mon-ecole.dz"]'
MAX_UPLOAD_SIZE_MB=10

# Limitation de débit (Rate Limiting)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_PUBLIC_PER_MINUTE=20
